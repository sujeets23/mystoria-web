# Supabase Configuration
# Replace with your Supabase project credentials from Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Secret Admin Passcode for accessing the hidden /admin portal
# Change this to whatever secure secret passphrase or PIN you prefer!
VITE_ADMIN_PASSCODE=your-secret-admin-passcode-here
